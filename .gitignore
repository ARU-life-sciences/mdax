/target
/old
/CADECT
/memory
/chris_data
/data/__pycache__/

# test_pal: ignore raw full-run data and large outputs; track scripts, sweep cache, derived TSVs
/test_pal/data/
/test_pal/out/subsample/
/test_pal/out/baseline/SRR24201687_first20k/*.fq.gz
/test_pal/mdax.out.fa
/test_pal/test

# test_celegans: ignore large raw data and large benchmark outputs; track scripts, dotplots, summary
/test_celegans/data/
/test_celegans/out/*.fasta
/test_celegans/out/*.out.fasta

# irx_tests: ignore large synthetic FASTA (regenerable via make_test_suite.py)
/irx_tests/beds/
/irx_tests/irx_truth.fa

# chris_crossvalidation: ignore generated output artefacts (plots, joined tables)
/tests/chris_crossvalidation/output/

# synth_bench: ignore generated genomes/reads/assemblies (regenerable via run_all.sh); track scripts only
/synth_bench/run_*/
/synth_bench/test_*/
/synth_bench/*.log

# test_single_nematode: ignore raw ONT read data (symlinked to lustre); track scripts and BUSCO results
/test_single_nematode/data/
